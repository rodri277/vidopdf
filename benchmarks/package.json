  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "vitest": "^5.0.3",
    "pdfjs-dist": "^6.4.299"
  },
  "dependencies": {
    "@vidopdf/core": "workspace:*",
    "@vidopdf/pdf-adapters": "workspace:*"
  }
}
