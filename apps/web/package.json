{
  "name": "@vidopdf/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vidopdf web app: React UI, workers and browser adapters.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:webkit": "playwright test -c playwright.webkit.config.ts",
    "size": "size-limit",
    "test": "vitest run",
    "e2e:firefox": "playwright test -c playwright.firefox.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vidopdf/core": "workspace:*",
    "@vidopdf/pdf-adapters": "workspace:*",
    "comlink": "^4.4.2",
    "i18next": "^26.5.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "Initial JavaScript (gzip)",
      "path": "dist/assets/index-*.js",
      "limit": "150 kB",
      "gzip": true
    }
  ]
}
